{
  "name": "epigenomics-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server for processed epigenomic feature evidence qualification",
  "type": "module",
  "main": "./dist/epimcp/index.js",
  "types": "./dist/epimcp/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/epimcp/index.d.ts",
      "import": "./dist/epimcp/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "benchmark_manifest.yaml",
    "benchmarks/expected",
    "benchmarks/fixtures/synthetic",
    "benchmarks/fixtures/frozen_public",
    "benchmarks/qualification_engine_benchmark.mjs",
    "src/epigenomics_mcp/__init__.py",
    "src/epigenomics_mcp/version.py",
    "src/epigenomics_mcp/governance/__init__.py",
    "src/epigenomics_mcp/governance/errors.py",
    "src/epigenomics_mcp/governance/project_to_spine.py",
    "src/epigenomics_mcp/governance/source_contract.py",
    "src/epigenomics_mcp/governance/spine_bridge.py",
    "tests/fixtures/governance",
    "vendor/schema-spine",
    "release-evidence",
    "scripts/export-schemas.mjs",
    "scripts/generate-golden-handoffs.mjs",
    "scripts/generate_spine_projection_golden.py",
    "scripts/lint.mjs",
    "scripts/release-evidence.mjs",
    "scripts/release-gate.mjs",
    "scripts/run-benchmarks.mjs",
    "scripts/scientific_invariants_gate.py",
    "scripts/smoke_mcp_http.mjs",
    "scripts/smoke_mcp_stdio.mjs",
    "scripts/update-benchmark-goldens.mjs",
    "scripts/validate-evaluation.mjs",
    "scripts/validate-handoffs.mjs",
    "scripts/vendor_verify.py",
    "scripts/verify-evidence.mjs",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CITATION.cff",
    "evaluation.xml",
    "pyproject.toml",
    "uv.lock",
    "LICENSE",
    "toxmcp.manifest.yaml"
  ],
  "bin": {
    "epimcp": "dist/epimcp/cli.js",
    "epimcp-http": "dist/epimcp/http.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/unit/contracts.test.ts tests/unit/schema_drift.test.ts tests/unit/schema_drift_integration.test.ts tests/unit/schema_export.test.ts tests/unit/handoff.test.ts tests/unit/handoff_validator.test.ts",
    "test:conformance": "npm run build && vitest run tests/conformance",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node scripts/lint.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=low",
    "smoke:mcp": "npm run smoke:mcp:stdio && npm run smoke:mcp:http",
    "smoke:mcp:stdio": "npm run build && node scripts/smoke_mcp_stdio.mjs",
    "smoke:mcp:http": "npm run build && node scripts/smoke_mcp_http.mjs",
    "eval:validate": "node scripts/validate-evaluation.mjs evaluation.xml",
    "export:schemas": "npm run build && node scripts/export-schemas.mjs",
    "release:evidence": "npm run build && node scripts/release-evidence.mjs",
    "verify:evidence": "npm run build && node scripts/verify-evidence.mjs",
    "validate:handoff": "node scripts/validate-handoffs.mjs",
    "vendor:verify": "python3 scripts/vendor_verify.py",
    "gate:scientific-invariants": "python3 scripts/scientific_invariants_gate.py",
    "benchmark": "npm run build && node benchmarks/qualification_engine_benchmark.mjs --features 10000 --replicates 6",
    "benchmark:gate": "node scripts/release-gate.mjs",
    "benchmark:ci": "npm run build && node scripts/release-gate.mjs",
    "benchmark:update": "npm run build && node scripts/update-benchmark-goldens.mjs --confirm",
    "start": "node dist/epimcp/cli.js",
    "mcp": "node dist/epimcp/cli.js serve",
    "mcp:smoke": "npm run smoke:mcp",
    "mcp:serve:http": "node dist/epimcp/http.js",
    "test:release-gates": "npm run security:audit && npm run eval:validate && npm run vendor:verify && npm run gate:scientific-invariants && npm run test:conformance && npm run test:contract && npm run benchmark:ci",
    "verify:release": "npm run lint && npm run security:audit && npm run eval:validate && npm run vendor:verify && npm run gate:scientific-invariants && npm test && npm run smoke:mcp && npm start -- --help && node dist/epimcp/cli.js --help && node -e \"import('./dist/epimcp/index.js')\" && npm run verify:evidence && npm pack --dry-run --json"
  },
  "keywords": [
    "mcp",
    "epigenomics",
    "bioinformatics",
    "toxmcp",
    "dose-response",
    "ngara"
  ],
  "author": "Epigenomics MCP maintainer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToxMCP/epigenomics-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ToxMCP/epigenomics-mcp/issues"
  },
  "homepage": "https://github.com/ToxMCP/epigenomics-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "4.3.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.26",
    "express-rate-limit": "^8.5.2",
    "ip-address": "^10.2.0",
    "qs": "^6.15.2"
  }
}
